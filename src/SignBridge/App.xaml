<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="SignBridge.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Surfaces (part of the 60% base): white panels on the mist background  -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            </Style>

            <!--  Translucent deep-blue chips drawn over the camera preview  -->
            <Style x:Key="CameraChip" TargetType="Border">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="BackgroundColor" Value="{StaticResource Scrim}" />
            </Style>

            <Style x:Key="Title" TargetType="Label">
                <Setter Property="FontFamily" Value="AppBold" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>
            <Style x:Key="Caption" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>
            <Style x:Key="IconGlyph" TargetType="Label">
                <Setter Property="FontFamily" Value="Icons" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>

            <Style x:Key="StatValue" TargetType="Label">
                <Setter Property="FontFamily" Value="AppBold" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
            </Style>

            <!--  The 10% accent: one main action per screen  -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
            </Style>

            <!--  Secondary actions: outlined in deep blue on the surface  -->
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderColor" Value="{StaticResource Secondary}" />
                <Setter Property="BorderWidth" Value="1.5" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
