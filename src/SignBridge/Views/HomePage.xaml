<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SignBridge.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="SignBridge"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="20" MaximumWidthRequest="640">

            <Label
                FontAttributes="Bold"
                FontSize="40"
                Text="🤟 SignBridge"
                TextColor="{StaticResource Primary}" />
            <Label
                FontSize="18"
                Text="Aprende el alfabeto de lengua de señas con tu cámara y convierte tus señas en voz."
                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />

            <Border
                Padding="20"
                BackgroundColor="{StaticResource Primary}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPracticeTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" FontSize="24" Text="🎯 Practicar" TextColor="White" />
                    <Label
                        FontSize="16"
                        Text="La app te muestra una letra y cómo formarla. Hazla frente a la cámara y gana puntos en tiempo real."
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="20"
                BackgroundColor="{StaticResource Tertiary}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTranslateTapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6">
                    <Label FontAttributes="Bold" FontSize="24" Text="🔊 Señas a voz" TextColor="White" />
                    <Label
                        FontSize="16"
                        Text="Deletrea una palabra letra por letra con tu mano y deja que el dispositivo la diga en voz alta."
                        TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label
                FontSize="13"
                LineBreakMode="WordWrap"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span FontAttributes="Bold" Text="Cómo funciona: " />
                        <Span Text="Los modelos de mano MediaPipe (OpenCV Zoo, en Hugging Face) encuentran 21 puntos de tu mano y una pequeña red neuronal, entrenada con muchas personas distintas, clasifica la forma de la mano. Todo se ejecuta en el dispositivo con ONNX Runtime: sin internet y sin que ninguna imagen salga del equipo. Alcance del piloto: alfabeto estático de la Lengua de Señas Americana (ASL); el reconocedor es intercambiable para sumar LSB o palabras completas más adelante." />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
