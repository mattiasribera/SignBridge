<?xml version="1.0" encoding="utf-8" ?>
<views:CameraPage
    x:Class="SignBridge.Views.TranslatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:theme="clr-namespace:SignBridge.Resources.Theme"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SignBridge.Views"
    xmlns:vm="clr-namespace:SignBridge.ViewModels"
    Title="Señas a voz"
    x:DataType="vm:TranslateViewModel">

    <views:CameraPage.ToolbarItems>
        <ToolbarItem Clicked="OnSwitchCameraClicked" Text="Cambiar cámara">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.SwitchCamera}" Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </views:CameraPage.ToolbarItems>

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="16">
        <!--  Two columns on wide screens (camera | lesson), stacked on phones  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ColumnDefinitions" Value="*,380" />
                            <Setter Property="RowDefinitions" Value="*" />
                            <Setter TargetName="Lesson" Property="Grid.Row" Value="0" />
                            <Setter TargetName="Lesson" Property="Grid.Column" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ColumnDefinitions" Value="*" />
                            <Setter Property="RowDefinitions" Value="*,Auto" />
                            <Setter TargetName="Lesson" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Lesson" Property="Grid.Column" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!--  Camera with skeleton, toggle and live reading  -->
        <Grid>
            <Border BackgroundColor="{StaticResource PrimaryDark}" StrokeShape="RoundRectangle 24" StrokeThickness="0">
                <toolkit:CameraView x:Name="CameraPreview" />
            </Border>
            <GraphicsView x:Name="Overlay" InputTransparent="True" IsVisible="{Binding ShowOverlay}" />
            <Button
                Margin="12"
                Padding="12,6"
                BackgroundColor="{StaticResource Scrim}"
                Command="{Binding ToggleOverlayCommand}"
                CornerRadius="16"
                FontSize="13"
                HorizontalOptions="Start"
                Text="{Binding OverlayButtonText}"
                TextColor="White"
                VerticalOptions="Start">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{Binding OverlayIcon}" Size="18" Color="{StaticResource Accent}" />
                </Button.ImageSource>
            </Button>
            <Border
                Margin="12"
                Padding="6"
                HeightRequest="136"
                HorizontalOptions="End"
                InputTransparent="True"
                IsVisible="{Binding ShowThumbnail}"
                Style="{StaticResource CameraChip}"
                VerticalOptions="Start"
                WidthRequest="128">
                <VerticalStackLayout>
                    <Label FontSize="12" HorizontalOptions="Center" Text="Lo que ve la IA" TextColor="White" />
                    <GraphicsView x:Name="Skeleton" HeightRequest="108" WidthRequest="116" />
                </VerticalStackLayout>
            </Border>
            <Border
                Margin="0,0,0,14"
                HorizontalOptions="Center"
                Style="{StaticResource CameraChip}"
                VerticalOptions="End"
                WidthRequest="280">
                <VerticalStackLayout Spacing="6">
                    <Label FontSize="13" HorizontalOptions="Center" Text="Seña entendida" TextColor="{StaticResource Secondary}" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Border
                            Padding="4"
                            BackgroundColor="White"
                            IsVisible="{Binding HandVisible}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Image Aspect="AspectFit" HeightRequest="64" Source="{Binding DetectedImage}" WidthRequest="64" />
                        </Border>
                        <Label
                            FontFamily="AppBold"
                            FontSize="32"
                            Text="{Binding DetectedLabel}"
                            TextColor="White"
                            VerticalOptions="Center" />
                        <Label
                            IsVisible="{Binding HandVisible}"
                            Text="{Binding DetectedConfidence, StringFormat='{0:P0}'}"
                            TextColor="{StaticResource Accent}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <ProgressBar Progress="{Binding CandidateProgress}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Built text and actions  -->
        <Border x:Name="Lesson" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="14">
                <Label Style="{StaticResource Caption}" Text="Texto" />
                <Border
                    Padding="14"
                    BackgroundColor="{StaticResource Base}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <Label
                        FontFamily="AppBold"
                        FontSize="34"
                        LineBreakMode="CharacterWrap"
                        MinimumHeightRequest="48"
                        Text="{Binding Text}"
                        TextColor="{StaticResource Primary}" />
                </Border>
                <Label Text="{Binding Status}" />
                <FlexLayout AlignItems="Center" Wrap="Wrap">
                    <Button
                        Margin="0,0,8,8"
                        Command="{Binding SpaceCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Espacio">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.Space}" Size="20" Color="{StaticResource Primary}" />
                        </Button.ImageSource>
                    </Button>
                    <Button
                        Margin="0,0,8,8"
                        Command="{Binding BackspaceCommand}"
                        SemanticProperties.Description="Borrar la última letra"
                        Style="{StaticResource QuietButton}"
                        Text="Borrar letra">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.Backspace}" Size="20" Color="{StaticResource Primary}" />
                        </Button.ImageSource>
                    </Button>
                    <Button
                        Margin="0,0,8,8"
                        Command="{Binding ClearCommand}"
                        Style="{StaticResource QuietButton}"
                        Text="Borrar todo">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.Clear}" Size="20" Color="{StaticResource Primary}" />
                        </Button.ImageSource>
                    </Button>
                </FlexLayout>
                <Label IsVisible="{Binding ShowKeyboardHints}" Style="{StaticResource Caption}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span FontFamily="Icons" FontSize="16" Text="{x:Static theme:Icons.Keyboard}" />
                            <Span Text="  Espacio agrega un espacio, Retroceso borra una letra y Supr borra todo." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button Command="{Binding SpeakCommand}" Style="{StaticResource AccentButton}" Text="Decir en voz alta">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.Speak}" Size="22" Color="{StaticResource OnAccent}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:CameraPage>
