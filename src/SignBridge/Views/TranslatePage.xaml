<?xml version="1.0" encoding="utf-8" ?>
<views:CameraPage
    x:Class="SignBridge.Views.TranslatePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SignBridge.Views"
    xmlns:vm="clr-namespace:SignBridge.ViewModels"
    Title="Señas a voz"
    x:DataType="vm:TranslateViewModel">

    <views:CameraPage.ToolbarItems>
        <ToolbarItem Clicked="OnSwitchCameraClicked" Text="Cambiar cámara" />
    </views:CameraPage.ToolbarItems>

    <Grid Padding="12" RowDefinitions="*,Auto" RowSpacing="12">

        <!--  Camera, hand skeleton and the understood sign  -->
        <Grid>
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="Black">
                <toolkit:CameraView x:Name="CameraPreview" />
            </Border>
            <GraphicsView x:Name="Overlay" InputTransparent="True" IsVisible="{Binding ShowOverlay}" />
            <Button
                Margin="10"
                Padding="12,6"
                BackgroundColor="#99000000"
                Command="{Binding ToggleOverlayCommand}"
                CornerRadius="16"
                FontSize="13"
                HorizontalOptions="Start"
                Text="{Binding OverlayButtonText}"
                TextColor="White"
                VerticalOptions="Start" />
            <Border
                Margin="10"
                Padding="4"
                BackgroundColor="#99000000"
                HeightRequest="130"
                HorizontalOptions="End"
                InputTransparent="True"
                IsVisible="{Binding ShowThumbnail}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                VerticalOptions="Start"
                WidthRequest="130">
                <VerticalStackLayout>
                    <Label FontSize="11" HorizontalOptions="Center" Text="Lo que ve la IA" TextColor="White" />
                    <GraphicsView x:Name="Skeleton" HeightRequest="108" WidthRequest="120" />
                </VerticalStackLayout>
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="16,8"
                BackgroundColor="#99000000"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="End"
                WidthRequest="260">
                <VerticalStackLayout Spacing="4">
                    <Label FontSize="14" HorizontalOptions="Center" Text="Seña entendida" TextColor="White" />
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Border
                            Padding="4"
                            BackgroundColor="White"
                            IsVisible="{Binding HandVisible}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0">
                            <Image Aspect="AspectFit" HeightRequest="72" Source="{Binding DetectedImage}" WidthRequest="72" />
                        </Border>
                        <Label FontAttributes="Bold" FontSize="28" Text="{Binding DetectedLabel}" TextColor="White" />
                        <Label
                            FontSize="16"
                            Text="{Binding DetectedConfidence, StringFormat='{0:P0}'}"
                            TextColor="{StaticResource PrimaryDark}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <ProgressBar Progress="{Binding CandidateProgress}" ProgressColor="{StaticResource PrimaryDark}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Built text and actions  -->
        <Border
            Grid.Row="1"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="10">
                <Label FontSize="14" Text="{Binding Status}" />
                <Border
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="0">
                    <Label
                        FontAttributes="Bold"
                        FontSize="32"
                        LineBreakMode="CharacterWrap"
                        MinimumHeightRequest="44"
                        Text="{Binding Text}" />
                </Border>
                <FlexLayout
                    AlignItems="Center"
                    JustifyContent="SpaceBetween"
                    Wrap="Wrap">
                    <HorizontalStackLayout Spacing="8">
                        <Button Command="{Binding SpaceCommand}" Text="Espacio" />
                        <Button Command="{Binding BackspaceCommand}" Text="⌫" />
                        <Button Command="{Binding ClearCommand}" Text="Borrar todo" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8">
                        <Button
                            BackgroundColor="{StaticResource Tertiary}"
                            Command="{Binding SpeakCommand}"
                            Text="🔊 Hablar" />
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:CameraPage>
