<?xml version="1.0" encoding="utf-8" ?>
<views:CameraPage
    x:Class="SignBridge.Views.PracticePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:theme="clr-namespace:SignBridge.Resources.Theme"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SignBridge.Views"
    xmlns:vm="clr-namespace:SignBridge.ViewModels"
    Title="Practicar"
    x:DataType="vm:PracticeViewModel">

    <views:CameraPage.ToolbarItems>
        <ToolbarItem Clicked="OnSwitchCameraClicked" Text="Cambiar cámara">
            <ToolbarItem.IconImageSource>
                <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.SwitchCamera}" Color="White" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </views:CameraPage.ToolbarItems>

    <Grid Padding="16" ColumnSpacing="16" RowSpacing="16">
        <!--  Two columns on wide screens (camera | lesson), stacked on phones  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ColumnDefinitions" Value="*,380" />
                            <Setter Property="RowDefinitions" Value="*" />
                            <Setter TargetName="Lesson" Property="Grid.Row" Value="0" />
                            <Setter TargetName="Lesson" Property="Grid.Column" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="ColumnDefinitions" Value="*" />
                            <Setter Property="RowDefinitions" Value="*,Auto" />
                            <Setter TargetName="Lesson" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Lesson" Property="Grid.Column" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!--  Camera with skeleton, toggle and live reading  -->
        <Grid>
            <Border BackgroundColor="{StaticResource PrimaryDark}" StrokeShape="RoundRectangle 24" StrokeThickness="0">
                <toolkit:CameraView x:Name="CameraPreview" />
            </Border>
            <GraphicsView x:Name="Overlay" InputTransparent="True" IsVisible="{Binding ShowOverlay}" />
            <Button
                Margin="12"
                Padding="12,6"
                BackgroundColor="{StaticResource Scrim}"
                Command="{Binding ToggleOverlayCommand}"
                CornerRadius="16"
                FontSize="13"
                HorizontalOptions="Start"
                Text="{Binding OverlayButtonText}"
                TextColor="White"
                VerticalOptions="Start">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{Binding OverlayIcon}" Size="18" Color="{StaticResource Accent}" />
                </Button.ImageSource>
            </Button>
            <Border
                Margin="12"
                Padding="6"
                HeightRequest="136"
                HorizontalOptions="End"
                InputTransparent="True"
                IsVisible="{Binding ShowThumbnail}"
                Style="{StaticResource CameraChip}"
                VerticalOptions="Start"
                WidthRequest="128">
                <VerticalStackLayout>
                    <Label FontSize="12" HorizontalOptions="Center" Text="Lo que ve la IA" TextColor="White" />
                    <GraphicsView x:Name="Skeleton" HeightRequest="108" WidthRequest="116" />
                </VerticalStackLayout>
            </Border>
            <Border
                Margin="0,0,0,14"
                HorizontalOptions="Center"
                Style="{StaticResource CameraChip}"
                VerticalOptions="End">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="Veo" TextColor="{StaticResource Secondary}" VerticalOptions="Center" />
                    <Border
                        Padding="3"
                        BackgroundColor="White"
                        IsVisible="{Binding HandVisible}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Image Aspect="AspectFit" HeightRequest="40" Source="{Binding DetectedImage}" WidthRequest="40" />
                    </Border>
                    <Label
                        FontFamily="AppBold"
                        FontSize="28"
                        Text="{Binding DetectedLabel}"
                        TextColor="White"
                        VerticalOptions="Center" />
                    <Label
                        IsVisible="{Binding HandVisible}"
                        Text="{Binding DetectedConfidence, StringFormat='{0:P0}'}"
                        TextColor="{StaticResource Accent}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!--  Lesson panel  -->
        <Border x:Name="Lesson" Style="{StaticResource Card}">
            <Border.Triggers>
                <DataTrigger Binding="{Binding IsCelebrating}" TargetType="Border" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource Success}" />
                    <Setter Property="StrokeThickness" Value="3" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="14">

                <!--  Score  -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" Text="{x:Static theme:Icons.Points}" />
                        <VerticalStackLayout>
                            <Label Style="{StaticResource StatValue}" Text="{Binding Score}" />
                            <Label Style="{StaticResource Caption}" Text="Puntos" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" Text="{x:Static theme:Icons.Streak}" />
                        <VerticalStackLayout>
                            <Label Style="{StaticResource StatValue}" Text="{Binding Streak}" />
                            <Label Style="{StaticResource Caption}" Text="Racha" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                        <Label Style="{StaticResource IconGlyph}" Text="{x:Static theme:Icons.Best}" />
                        <VerticalStackLayout>
                            <Label Style="{StaticResource StatValue}" Text="{Binding BestStreak}" />
                            <Label Style="{StaticResource Caption}" Text="Mejor racha" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />

                <!--  Target sign  -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border
                        Padding="8"
                        BackgroundColor="{StaticResource Base}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Image Aspect="AspectFit" HeightRequest="128" Source="{Binding TargetImage}" WidthRequest="112" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Style="{StaticResource Caption}" Text="Haz la letra" />
                        <Label
                            FontFamily="AppBold"
                            FontSize="64"
                            LineHeight="0.9"
                            Text="{Binding Target}"
                            TextColor="{StaticResource Primary}" />
                        <Label LineHeight="1.2" Text="{Binding Hint}" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>

                <ProgressBar Progress="{Binding HoldProgress}" />
                <Label Text="{Binding Status}" />
                <Button
                    Command="{Binding SkipCommand}"
                    HorizontalOptions="Start"
                    Style="{StaticResource QuietButton}"
                    Text="Saltar letra">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Icons" Glyph="{x:Static theme:Icons.Skip}" Size="20" Color="{StaticResource Primary}" />
                    </Button.ImageSource>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</views:CameraPage>
