<?xml version="1.0" encoding="utf-8" ?>
<views:CameraPage
    x:Class="SignBridge.Views.PracticePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SignBridge.Views"
    xmlns:vm="clr-namespace:SignBridge.ViewModels"
    Title="Practice"
    x:DataType="vm:PracticeViewModel">

    <views:CameraPage.ToolbarItems>
        <ToolbarItem Clicked="OnSwitchCameraClicked" Text="Switch camera" />
    </views:CameraPage.ToolbarItems>

    <Grid Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <!--  Score bar  -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="SCORE" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding Score}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="STREAK 🔥" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding Streak}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="BEST" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding BestStreak}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Camera with guide frame and live detection  -->
        <Grid x:Name="CameraHost" Grid.Row="1">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="Black">
                <toolkit:CameraView x:Name="CameraPreview" />
            </Border>
            <Border
                x:Name="Guide"
                HorizontalOptions="Center"
                InputTransparent="True"
                Stroke="White"
                StrokeDashArray="6,4"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="3"
                VerticalOptions="Center" />
            <Border
                Margin="0,0,0,12"
                Padding="16,8"
                BackgroundColor="#99000000"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="End">
                <HorizontalStackLayout Spacing="10">
                    <Label FontSize="16" Text="I see:" TextColor="White" VerticalOptions="Center" />
                    <Label FontAttributes="Bold" FontSize="28" Text="{Binding DetectedLabel}" TextColor="White" />
                    <Label
                        FontSize="16"
                        Text="{Binding DetectedConfidence, StringFormat='{0:P0}'}"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!--  Target letter card  -->
        <Border
            Grid.Row="2"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
            <Border.Triggers>
                <DataTrigger Binding="{Binding IsCelebrating}" TargetType="Border" Value="True">
                    <Setter Property="BackgroundColor" Value="#22C55E" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Label
                    Grid.RowSpan="2"
                    FontAttributes="Bold"
                    FontSize="72"
                    Text="{Binding Target}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label FontAttributes="Bold" FontSize="16" Text="Sign this letter" />
                    <Label FontSize="15" Text="{Binding Hint}" />
                </VerticalStackLayout>
                <ProgressBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Progress="{Binding HoldProgress}"
                    ProgressColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    FontSize="14"
                    Text="{Binding Status}" />
                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    Spacing="8">
                    <Label Text="Mirror" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding Mirror}" />
                    <Button Command="{Binding SkipCommand}" Text="Skip" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</views:CameraPage>
