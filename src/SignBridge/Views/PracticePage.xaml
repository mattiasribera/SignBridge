<?xml version="1.0" encoding="utf-8" ?>
<views:CameraPage
    x:Class="SignBridge.Views.PracticePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:SignBridge.Views"
    xmlns:vm="clr-namespace:SignBridge.ViewModels"
    Title="Practicar"
    x:DataType="vm:PracticeViewModel">

    <views:CameraPage.ToolbarItems>
        <ToolbarItem Clicked="OnSwitchCameraClicked" Text="Cambiar cámara" />
    </views:CameraPage.ToolbarItems>

    <Grid Padding="12" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <!--  Score bar  -->
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="PUNTOS" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding Score}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="RACHA 🔥" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding Streak}" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource StatCaption}" Text="MEJOR" />
                    <Label Style="{StaticResource StatValue}" Text="{Binding BestStreak}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!--  Camera, hand skeleton and live detection  -->
        <Grid Grid.Row="1">
            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="Black">
                <toolkit:CameraView x:Name="CameraPreview" />
            </Border>
            <GraphicsView x:Name="Overlay" InputTransparent="True" IsVisible="{Binding ShowOverlay}" />
            <Button
                Margin="10"
                Padding="12,6"
                BackgroundColor="#99000000"
                Command="{Binding ToggleOverlayCommand}"
                CornerRadius="16"
                FontSize="13"
                HorizontalOptions="Start"
                Text="{Binding OverlayButtonText}"
                TextColor="White"
                VerticalOptions="Start" />
            <Border
                Margin="10"
                Padding="4"
                BackgroundColor="#99000000"
                HeightRequest="130"
                HorizontalOptions="End"
                InputTransparent="True"
                IsVisible="{Binding ShowThumbnail}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="0"
                VerticalOptions="Start"
                WidthRequest="130">
                <VerticalStackLayout>
                    <Label FontSize="11" HorizontalOptions="Center" Text="Lo que ve la IA" TextColor="White" />
                    <GraphicsView x:Name="Skeleton" HeightRequest="108" WidthRequest="120" />
                </VerticalStackLayout>
            </Border>
            <Border
                Margin="0,0,0,12"
                Padding="16,8"
                BackgroundColor="#99000000"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                VerticalOptions="End">
                <HorizontalStackLayout Spacing="10">
                    <Label FontSize="16" Text="Veo:" TextColor="White" VerticalOptions="Center" />
                    <Border
                        Padding="3"
                        BackgroundColor="White"
                        IsVisible="{Binding HandVisible}"
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0">
                        <Image Aspect="AspectFit" HeightRequest="44" Source="{Binding DetectedImage}" WidthRequest="44" />
                    </Border>
                    <Label FontAttributes="Bold" FontSize="28" Text="{Binding DetectedLabel}" TextColor="White" />
                    <Label
                        FontSize="16"
                        Text="{Binding DetectedConfidence, StringFormat='{0:P0}'}"
                        TextColor="{StaticResource PrimaryDark}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!--  Target letter card  -->
        <Border
            Grid.Row="2"
            Padding="16"
            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="0">
            <Border.Triggers>
                <DataTrigger Binding="{Binding IsCelebrating}" TargetType="Border" Value="True">
                    <Setter Property="BackgroundColor" Value="#22C55E" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Border
                    Grid.RowSpan="2"
                    Padding="6"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="120"
                        Source="{Binding TargetImage}"
                        WidthRequest="120" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <HorizontalStackLayout Spacing="10">
                        <Label FontAttributes="Bold" FontSize="16" Text="Haz la letra" VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="36"
                            Text="{Binding Target}"
                            TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                    <Label FontSize="15" Text="{Binding Hint}" />
                </VerticalStackLayout>
                <ProgressBar
                    Grid.Row="1"
                    Grid.Column="1"
                    Progress="{Binding HoldProgress}"
                    ProgressColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    FontSize="14"
                    Text="{Binding Status}" />
                <HorizontalStackLayout
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    Spacing="8">
                    <Button Command="{Binding SkipCommand}" Text="Saltar" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</views:CameraPage>
